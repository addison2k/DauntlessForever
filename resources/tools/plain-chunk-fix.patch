+// Decompress returns the payload of a raw chunk downloaded from the CDN.
+//
+// A chunk is a binary header followed by the payload. The header's StoredAs
+// byte says whether the payload is zlib-compressed or stored as plain bytes.
+// Data that does not compress well (already-compressed paks, audio, video) is
+// stored plain, so both cases must be handled.
+//
+// Header layout (little endian): magic u32, version u32, headerSize u32,
+// dataSizeCompressed u32, GUID 16 bytes, rollingHash u64, storedAs u8 at
+// offset 40.
 func Decompress(data []byte) ([]byte, error) {
 	if len(data) < 9 {
 		return nil, errors.New("chunk data too short: need at least 9 bytes")
 	}
 
+	const storedAsOffset = 40
+	if len(data) > storedAsOffset && binary.LittleEndian.Uint32(data[0:4]) == ChunkHeaderMagic {
+		headerSize := binary.LittleEndian.Uint32(data[8:12])
+		if headerSize <= storedAsOffset || int64(headerSize) > int64(len(data)) {
+			return nil, fmt.Errorf("chunk header size %d is invalid for data length %d", headerSize, len(data))
+		}
+		storedAs := ChunkStoredAs(data[storedAsOffset])
+		payload := data[headerSize:]
+
+		if storedAs&ChunkStoredAsEncrypted != 0 {
+			return nil, errors.New("chunk is encrypted")
+		}
+		if storedAs&ChunkStoredAsCompressed == 0 {
+			// Stored as plain bytes: the payload is the chunk data.
+			out := make([]byte, len(payload))
+			copy(out, payload)
+			return out, nil
+		}
+		return inflate(payload)
+	}
+
