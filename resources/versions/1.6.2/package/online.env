# Dauntless Forever - standard settings for games other players can join
# (Host with friends, Play online, LAN - HOST). While you host, these replace the same lines in
# backend\metagame\.env and your Game Rules picks, so everyone in your game levels up the normal way.
# Solo play (Play solo) keeps your own .env and Game Rules: change those as you like for yourself.
# This file is replaced by every server-files update.
PROGRESSION_MODE=real
PROGRESSION_XP_TIER=0
PROGRESSION_REBUILD=0
PROGRESSION_POST_OK=1
REAL_OBJECTIVES=0
GRANT_REPLY=track
BOUNTY_PASS_XP=1
BOUNTY_DELETE_CLAIMED=1
CELL_EXCHANGE_MAX_SECONDS=420
ESCALATION_MODE=real
HEROIC_ESCALATION=1
PRESTIGE_MAX_RANK=100
REFORGE_REWARD=CURRENCY_PJM_PRESTIGE_FILLED:1
LOADOUT_SLOTS=10
RULE_WEAPON_XP=2
RULE_PASS_XP=1
RULE_LOOT=1
RULE_FREE_CRAFTING=0
